{
  "name": "AI Company Dev Container",
  "image": "mcr.microsoft.com/devcontainers/python:3.12",
  "workspaceFolder": "/workspaces/ai-company",
  "remoteEnv": {
    "WORKSPACE_DIR": "/workspaces/ai-company/workspace"
  },
  "postCreateCommand": "pip install -r requirements.txt && ([ -f .env ] || cp .env.example .env)",
  "forwardPorts": [8080],
  "portsAttributes": {
    "8080": {
      "label": "Dashboard"
    }
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python"
      ]
    }
  }
}
